# AgentOS V0.3.2 local environment. Generate a private .env with:
#   Windows: powershell -ExecutionPolicy Bypass -File .\scripts\New-AgentOSEnv.ps1
#   macOS:   pwsh -File ./scripts/New-AgentOSEnv.ps1

PORT=3080
DOMAIN_CLIENT=http://localhost:3080
DOMAIN_SERVER=http://localhost:3080
MONGO_URI=mongodb://mongodb:27017/LibreChat

# Optional supporting services. They are disabled in the V0.3.1 default profile.
# Start them later with: docker compose --project-name agentos --env-file .env -f .\deployment\compose.yaml --profile supporting up -d
MEILI_MASTER_KEY=__GENERATE_MEILI_MASTER_KEY__
RAG_PORT=8000
VECTORDB_DATABASE=mydatabase
VECTORDB_USER=myuser
VECTORDB_PASSWORD=__GENERATE_VECTORDB_PASSWORD__

# V0.1 local account bootstrap. Disable public registration in V0.7.
ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=true
ALLOW_SOCIAL_LOGIN=false
ALLOW_SOCIAL_REGISTRATION=false
ALLOW_PASSWORD_RESET=false
ALLOW_ACCOUNT_DELETION=false
ALLOW_SHARED_LINKS=false

# Session signing keys. These must be unique per installation.
JWT_SECRET=__GENERATE_JWT_SECRET__
JWT_REFRESH_SECRET=__GENERATE_JWT_REFRESH_SECRET__

NODE_ENV=production
DEBUG_LOGGING=false
DEBUG_CONSOLE=false
APP_TITLE=立能派 Agent OS

# Company relay. Keep these values in the private .env only.
# The config synchronizer reports BLOCKED when any value is missing.
AGENTOS_LLM_BASE_URL=__REQUIRED__
AGENTOS_LLM_API_KEY=__REQUIRED__
AGENTOS_LLM_MODEL=gpt-5.5
AGENTOS_LLM_MODELS=gpt-5.5,gpt-5.6-sol,gpt-5.6-terra,gpt-5.6-luna
AGENTOS_LLM_PROTOCOL=chat_completions
AGENTOS_IMAGE_MODEL=gpt-image-2
AGENTOS_IMAGE_MODELS=gpt-image-1.5,gpt-image-2
AGENTOS_DEFAULT_LOCALE=zh-Hans
ENDPOINTS=custom,agents

# Container overrides. Release/Windows defaults stay pinned in Compose.
# The macOS M2 scripts export native arm64 development overrides at runtime;
# do not copy the values below unless you need a permanent local override.
# AGENTOS_API_IMAGE=agentos/librechat:v0.3.2-m2
# AGENTOS_API_PLATFORM=linux/arm64
# AGENTOS_API_PULL_POLICY=never
# AGENTOS_MONGO_IMAGE=mongo:8.0.20
# AGENTOS_MONGO_PLATFORM=linux/arm64

# Submit Flow MCP adapter. Keep the real token in the private .env only.
# The AgentOS synchronizer omits submit-flow until all required values exist.
SUBMIT_MCP_URL=http://host.docker.internal:8121/mcp
SUBMIT_MCP_TOKEN=__REQUIRED_PRIVATE_SERVICE_TOKEN__
SUBMIT_TENANT_ID=lnp-default
SUBMIT_AGENT_ID=smart-submit-v1
SUBMIT_AGENT_VERSION=1.0.0
SUBMIT_MCP_ALLOWED_ADDRESS=host.docker.internal:8121
