    "provider": "立能派中转",
    "model": "gpt-5.5",
    "allowed_models": ["gpt-5.5"],
    "reasoning": "medium",
    "skills_enabled": true,
    "mcp_server_ids": ["submit-flow"],
    "skill_ids": ["submit-flow-skill"],
    "tool_ids": [
      "submit_flow.create_task",
      "submit_flow.attach_file",
      "submit_flow.run_task",
      "submit_flow.get_task",
      "submit_flow.get_review",
      "submit_flow.confirm_task",
      "submit_flow.list_outputs"
    ],
    "allow_model_override": false,
    "allow_reasoning_override": false,
    "allow_tool_override": false
  },
  "risk_policy": {
    "requires_human_confirmation": ["submit_flow.confirm_task"],
